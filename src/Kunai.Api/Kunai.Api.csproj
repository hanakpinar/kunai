<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- XML comments feed the OpenAPI document; undocumented members are allowed. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <UserSecretsId>kunai-api</UserSecretsId>
  </PropertyGroup>

  <!-- dotnet publish -t:PublishContainer builds the image without a Dockerfile.
       "chiseled-extra" adds ICU and time zone data, needed for tr-TR text handling and IANA time zones. -->
  <PropertyGroup>
    <ContainerRepository>kunai-api</ContainerRepository>
    <ContainerFamily>noble-chiseled-extra</ContainerFamily>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kunai.Api.UnitTests" />
    <InternalsVisibleTo Include="Kunai.Api.IntegrationTests" />
    <InternalsVisibleTo Include="Kunai.ArchitectureTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql.OpenTelemetry" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Kunai.ServiceDefaults/Kunai.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
