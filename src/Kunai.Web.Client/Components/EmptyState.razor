<div class="empty-state">
    <img src="favicon.svg" alt="" width="48" height="48" />
    <p>@Message</p>
    @ChildContent
</div>

@code {
    [Parameter, EditorRequired]
    public string Message { get; set; } = string.Empty;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
