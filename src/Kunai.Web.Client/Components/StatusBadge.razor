@inject CatalogMetadata Catalog

<span class="status-badge status-badge--@CssStatus">@_label</span>

@code {
    private string _label = string.Empty;

    [Parameter, EditorRequired]
    public ItemType? Type { get; set; }

    [Parameter, EditorRequired]
    public ShelfStatus? Status { get; set; }

    private string CssStatus => Status?.ToString().ToLowerInvariant() ?? "unknown";

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _label = await Catalog.StatusLabelAsync(Type, Status);
        }
        catch (Exception exception) when (ApiProblem.IsApiFailure(exception))
        {
            // The registry did not load: a badge never breaks the page, it falls back to a neutral label.
            _label = CatalogMetadata.GenericStatusLabel(Status);
        }
    }
}
