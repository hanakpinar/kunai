@page "/forgot-password"
@using Microsoft.Kiota.Abstractions
@inject KunaiApiClient Api

<PageTitle>Şifremi unuttum · Kunai</PageTitle>

<section class="auth-card">
    @if (_sent)
    {
        <h1>E-postanı kontrol et</h1>
        <p>Bu adrese kayıtlı bir hesap varsa, şifre sıfırlama bağlantısı birkaç dakika içinde gelir. Bağlantı bir saat geçerli.</p>
        <a class="button button--block" href="login">Giriş sayfasına dön</a>
    }
    else
    {
        <h1>Şifreni sıfırla</h1>
        <p class="muted">E-posta adresini yaz, sana bir sıfırlama bağlantısı gönderelim.</p>
        <EditForm Model="_form" OnValidSubmit="SubmitAsync" class="form">
            <DataAnnotationsValidator />
            <label class="field">
                <span>E-posta</span>
                <InputText type="email" @bind-Value="_form.Email" autocomplete="email" />
                <ValidationMessage For="() => _form.Email" />
            </label>
            <ProblemAlert Problem="_problem" />
            <button type="submit" class="button button--block" disabled="@_busy">Bağlantı gönder</button>
        </EditForm>
    }
</section>

@code {
    private readonly EmailForm _form = new();
    private ApiProblem? _problem;
    private bool _busy;
    private bool _sent;

    private async Task SubmitAsync()
    {
        _busy = true;
        _problem = null;
        try
        {
            await Api.Api.V1.Auth.Password.Forgot.PostAsync(new ForgotPasswordRequest { Email = _form.Email.Trim() });
            _sent = true;
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            _problem = ApiProblem.From(exception);
        }
        finally
        {
            _busy = false;
        }
    }
}
