@page "/reset-password"
@using Microsoft.Kiota.Abstractions
@inject KunaiApiClient Api

<PageTitle>Yeni şifre · Kunai</PageTitle>

<section class="auth-card">
    @if (_done)
    {
        <h1>Şifren değişti</h1>
        <p>Güvenliğin için bütün cihazlardaki oturumların kapatıldı. Yeni şifrenle giriş yapabilirsin.</p>
        <a class="button button--block" href="login">Giriş yap</a>
    }
    else
    {
        <h1>Yeni şifre belirle</h1>
        <EditForm Model="_form" OnValidSubmit="SubmitAsync" class="form">
            <DataAnnotationsValidator />
            <label class="field">
                <span>Yeni şifre</span>
                <InputText type="password" @bind-Value="_form.Password" autocomplete="new-password" />
                <ValidationMessage For="() => _form.Password" />
                <FieldError Problem="_problem" Field="newPassword" />
            </label>
            <label class="field">
                <span>Yeni şifre (tekrar)</span>
                <InputText type="password" @bind-Value="_form.PasswordAgain" autocomplete="new-password" />
                <ValidationMessage For="() => _form.PasswordAgain" />
            </label>
            <ProblemAlert Problem="@(_problem is { Fields.Count: 0 } ? _problem : null)" />
            <button type="submit" class="button button--block" disabled="@_busy">Şifreyi değiştir</button>
        </EditForm>
    }
</section>

@code {
    private readonly NewPasswordForm _form = new();
    private ApiProblem? _problem;
    private bool _busy;
    private bool _done;

    [SupplyParameterFromQuery]
    public Guid? UserId { get; set; }

    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    private async Task SubmitAsync()
    {
        _busy = true;
        _problem = null;
        try
        {
            await Api.Api.V1.Auth.Password.Reset.PostAsync(new ResetPasswordRequest { UserId = UserId, Token = Token, NewPassword = _form.Password });
            _done = true;
        }
        catch (Exception exception) when (ApiProblem.IsApiFailure(exception))
        {
            _problem = ApiProblem.From(exception);
        }
        finally
        {
            _busy = false;
        }
    }
}
