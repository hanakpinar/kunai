@using System.Globalization
@using Microsoft.Kiota.Abstractions
@inject KunaiApiClient Api

<ProblemAlert Problem="_problem" />

@if (_stats is null)
{
    @if (_problem is null)
    {
        <Spinner Label="İstatistikler yükleniyor…" />
    }
}
else
{
    <div class="toolbar">
        <label class="year">
            <span>Yıl</span>
            <select id="stats-year" value="@_stats.Year" disabled="@_loading" @onchange="ChangeYearAsync">
                @foreach (var year in Years)
                {
                    <option value="@year">@year</option>
                }
            </select>
        </label>
        @if (_loading)
        {
            <span class="muted small" role="status">Yükleniyor…</span>
        }
    </div>

    <h3>Türlere göre</h3>
    @if (_stats.Types is not { Count: > 0 } types)
    {
        <EmptyState Message="@($"{_stats.Year} yılında bitirilen bir şey yok.")" />
    }
    else
    {
        <div class="stat-grid">
            @foreach (var type in types)
            {
                <div class="stat">
                    <div class="stat__value">@ProfileFormat.Number(type.Completed)</div>
                    <div class="stat__label">@CatalogMetadata.TypeName(type.Type)</div>
                    <div class="stat__label">
                        @(type.AverageRating is { } average ? $"Ortalama puan {ProfileFormat.Rating(average)}" : "Puan verilmemiş")
                    </div>
                </div>
            }
        </div>
    }

    <h3>Aylara göre</h3>
    <div class="months">
        <div class="month-bars" role="img" aria-label="@MonthSummary">
            @for (var month = 1; month <= 12; month++)
            {
                var count = CountIn(month);
                <div class="month-bars__bar" style="@ProfileFormat.Height(ProfileFormat.Percent(count, MaxMonth))"
                     title="@($"{ProfileFormat.MonthName(month)}: {count}")"></div>
            }
        </div>
        <div class="month-bars__labels" aria-hidden="true">
            @foreach (var initial in ProfileFormat.MonthInitials)
            {
                <span>@initial</span>
            }
        </div>
    </div>

    <h3>Toplamlar</h3>
    <div class="stat-grid">
        <div class="stat">
            <div class="stat__value">@ProfileFormat.Number(_stats.PagesRead)</div>
            <div class="stat__label">Okunan sayfa</div>
        </div>
        <div class="stat">
            <div class="stat__value">@ProfileFormat.Number(_stats.EpisodesWatched)</div>
            <div class="stat__label">İzlenen bölüm</div>
        </div>
        <div class="stat">
            <div class="stat__value">@ProfileFormat.Number(_stats.ChaptersRead)</div>
            <div class="stat__label">Okunan manga bölümü</div>
        </div>
    </div>
}

@code {
    private StatsResponse? _stats;
    private ApiProblem? _problem;
    private bool _loading;

    [Parameter, EditorRequired]
    public string Username { get; set; } = string.Empty;

    // The selected year is always offered, also when nothing was completed in it.
    private IEnumerable<int> Years =>
        (_stats?.AvailableYears ?? []).OfType<int>().Append(_stats?.Year ?? DateTime.Now.Year).Distinct().OrderDescending();

    private int MaxMonth => Enumerable.Range(1, 12).Max(CountIn);

    private string MonthSummary =>
        "Aylara göre bitirilenler: " + string.Join(", ", Enumerable.Range(1, 12).Select(m => $"{ProfileFormat.MonthName(m)} {CountIn(m)}"));

    protected override Task OnInitializedAsync() => LoadAsync(year: null);

    private int CountIn(int month) => _stats?.CompletedByMonth?.ElementAtOrDefault(month - 1) ?? 0;

    private Task ChangeYearAsync(ChangeEventArgs args) =>
        int.TryParse(args.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var year) ? LoadAsync(year) : Task.CompletedTask;

    private async Task LoadAsync(int? year)
    {
        _loading = true;
        _problem = null;
        try
        {
            _stats = await Api.Api.V1.Users[Username].Stats.GetAsync(c => c.QueryParameters.Year = year);
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException)
        {
            _problem = ApiProblem.From(exception);
        }
        finally
        {
            _loading = false;
        }
    }
}
