@page "/u/{Username}"
@implements IAsyncDisposable
@inject KunaiApiClient Api
@inject IJSRuntime JS

<PageTitle>@PageTitleText</PageTitle>

@if (_notFound)
{
    <h1 class="visually-hidden">Profil bulunamadı</h1>
    <EmptyState Message="Bu kullanıcı yok ya da profili gizli.">
        <a class="button" href="">Ana sayfaya dön</a>
    </EmptyState>
}
else if (_problem is not null || _retrying)
{
    @* The heading stays while "Tekrar dene" loads the profile again, and takes the focus that the button had. *@
    <h1 class="visually-hidden" tabindex="-1" @ref="_problemHeading">Profil</h1>
    @if (_problem is not null)
    {
        <LoadProblem Problem="_problem" Busy="_loading" OnRetry="RetryAsync" />
    }
    else
    {
        <Spinner Label="Profil yükleniyor…" />
    }
}
else if (_profile is null)
{
    <Spinner Label="Profil yükleniyor…" />
}
else
{
    <div @key="_profile.Username">
        <ProfileHeader Profile="_profile" IsOwner="_isOwner" @ref="_header" />

        <section class="section" aria-labelledby="profile-summary-title">
            <h2 id="profile-summary-title">Bitirilenler</h2>
            @if (_completed.Count == 0)
            {
                <EmptyState Message="Henüz bitirilen bir şey yok. İlk hedef yolda!" />
            }
            else
            {
                <div class="stat-grid">
                    @foreach (var count in _completed)
                    {
                        <div class="stat">
                            <div class="stat__value">@ProfileFormat.Number(count.Completed)</div>
                            <div class="stat__label">@CatalogMetadata.TypeName(count.Type)</div>
                        </div>
                    }
                    <div class="stat stat--year">
                        <div class="stat__value">@ProfileFormat.Number(_thisYearTotal)</div>
                        <div class="stat__label">@(_profile.ThisYear?.Year) yılında</div>
                    </div>
                </div>
            }
        </section>

        <section class="section" aria-labelledby="profile-favorites-title">
            <h2 id="profile-favorites-title">Favoriler</h2>
            @if (_profile.Favorites is not { Count: > 0 } favorites)
            {
                <EmptyState Message="Henüz favori yok." />
            }
            else
            {
                <div class="card-grid">
                    @foreach (var item in favorites)
                    {
                        <ItemCard Href="@($"items/{item.Id}")" Title="@(item.Title ?? string.Empty)" Type="item.Type" Year="item.Year"
                                  Subtitle="@(string.Join(", ", item.Creators?.Take(2) ?? []))" CoverUrl="@item.CoverUrl" />
                    }
                </div>
            }
        </section>

        <section class="section" aria-labelledby="profile-tabs-title">
            <h2 id="profile-tabs-title" class="visually-hidden">Raf, istatistikler ve görevler</h2>
            @* The ARIA tabs pattern: only the selected tab is in the Tab order; arrows, Home and End move between the tabs. *@
            <div class="tabs" role="tablist" aria-labelledby="profile-tabs-title" @onkeydown="MoveBetweenTabsAsync" @ref="_tablist">
                @for (var index = 0; index < Tabs.Length; index++)
                {
                    var position = index;
                    var (tab, label) = Tabs[position];
                    var selected = _tab == tab;
                    <button type="button" role="tab" id="@TabId(tab)" aria-controls="@PanelId(tab)" aria-selected="@(selected ? "true" : "false")"
                            tabindex="@(selected ? 0 : -1)" class="@(selected ? "active" : null)" @ref="_tabButtons[position]"
                            @onclick="() => Select(tab)">@label</button>
                }
            </div>

            @* Every panel is always there, so aria-controls always resolves. Its content mounts the first time its tab
               is opened and then stays, so switching back keeps the loaded shelf, year and filters. A panel takes the
               focus when a control inside it goes away (Tekrar dene), through the function cascaded to its content. *@
            @for (var index = 0; index < Tabs.Length; index++)
            {
                var position = index;
                var tab = Tabs[position].Tab;
                <div role="tabpanel" id="@PanelId(tab)" aria-labelledby="@TabId(tab)" hidden="@(_tab != tab)" tabindex="-1" @ref="_panels[position]">
                    @if (_opened.Contains(tab))
                    {
                        <CascadingValue Name="@ProfilePanel.FocusName" Value="_focusPanel[position]" IsFixed="true">
                            @switch (tab)
                            {
                                case ProfileTab.Shelf:
                                    <ProfileShelf Username="@_profile.Username" />
                                    break;
                                case ProfileTab.Stats:
                                    <ProfileStats Username="@_profile.Username" />
                                    break;
                                default:
                                    <ProfileGoals Username="@_profile.Username" Year="_goalYear" IsOwner="_isOwner" IsSignedIn="_isSignedIn" />
                                    break;
                            }
                        </CascadingValue>
                    }
                </div>
            }
        </section>

        <BeltGuide Current="_profile.Rank" />
    </div>
}

@code {
    /// <summary>The module that keeps the tab keys from scrolling the page (see PreventTabKeyScrollingAsync).</summary>
    internal const string ScriptPath = "./Pages/Profile/PublicProfile.razor.js";

    private static readonly (ProfileTab Tab, string Label)[] Tabs =
        [(ProfileTab.Shelf, "Raf"), (ProfileTab.Stats, "İstatistikler"), (ProfileTab.Goals, "Görevler")];

    private readonly HashSet<ProfileTab> _opened = [];
    private readonly ElementReference[] _tabButtons = new ElementReference[Tabs.Length];
    private readonly ElementReference[] _panels = new ElementReference[Tabs.Length];
    private readonly Func<ValueTask>[] _focusPanel;
    private CancellationTokenSource? _cancel;
    private ElementReference _tablist;
    private ElementReference _problemHeading;
    private ProfileHeader? _header;
    private Task<IJSObjectReference>? _tabKeys;
    private string? _guardedTablist;
    private PublicProfileResponse? _profile;
    private List<TypeCounts> _completed = [];
    private int _thisYearTotal;
    private int _goalYear;
    private ApiProblem? _problem;
    private bool _notFound;
    private bool _loading;
    private bool _isOwner;
    private bool _isSignedIn;
    private string? _loadedFor;
    private ProfileTab _tab;

    // A retry of a failed load runs: the heading above the problem stays (and keeps the focus) until it ends.
    private bool _retrying;
    private bool _focusProblemHeading;
    private bool _focusProfileHeading;

    public PublicProfile() =>
        _focusPanel = [.. Enumerable.Range(0, Tabs.Length).Select(position => (Func<ValueTask>)(() => _panels[position].FocusAsync()))];

    [Parameter]
    public string Username { get; set; } = string.Empty;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private string PageTitleText => _profile is null ? "Profil · Kunai" : $"{_profile.DisplayName} (@{_profile.Username}) · Kunai";

    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(_loadedFor, Username, StringComparison.Ordinal))
        {
            // Same profile, new session (signed out, or it ended): only the owner's controls change.
            ShowViewer(await ViewerAsync());
            return;
        }

        // The same page instance is reused when navigating from one profile to another: start over on the Raf tab.
        _loadedFor = Username;
        _retrying = false;
        _opened.Clear();
        Select(ProfileTab.Shelf);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        // Blazor does not wait for an earlier OnParametersSetAsync: a load for the previous profile may still be
        // running. Cancel it, and ignore whatever it answers, so the newest profile always wins.
        var previous = _cancel;
        _cancel = new CancellationTokenSource();
        var token = _cancel.Token;
        var username = Username;
        _profile = null;
        _problem = null;
        _notFound = false;
        _loading = true;
        try
        {
            if (previous is not null)
            {
                await previous.CancelAsync();
                previous.Dispose();
            }

            var profile = await Api.Api.V1.Users[username].GetAsync(cancellationToken: token);
            var viewer = await ViewerAsync();
            if (token.IsCancellationRequested)
            {
                return;
            }

            _completed = [.. profile?.Counts?.Where(c => c.Completed > 0) ?? []];
            _thisYearTotal = profile?.ThisYear?.Completed?.Sum(c => c.Count ?? 0) ?? 0;
            _goalYear = profile?.ThisYear?.Year ?? DateTime.Now.Year;
            _profile = profile;
            _notFound = profile is null;
            ShowViewer(viewer);
        }
        catch (Exception exception) when (token.IsCancellationRequested && (exception is OperationCanceledException || ApiProblem.IsApiFailure(exception)))
        {
            // A newer load (another profile) cancelled this one, or this one failed after that: the newer one shows
            // its own answer, and a stale problem here would hide it (a successful load never clears _problem).
        }
        catch (Exception exception) when (ApiProblem.IsApiFailure(exception))
        {
            var problem = ApiProblem.From(exception);
            _notFound = problem.Status == 404;
            _problem = _notFound ? null : problem;
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                _loading = false;
            }
        }
    }

    // "Tekrar dene" goes away with the problem: the heading above it takes the focus while the profile loads, and the
    // profile's own heading once it is there.
    private async Task RetryAsync()
    {
        var username = Username;
        _retrying = true;
        _focusProblemHeading = true;
        await LoadAsync();
        if (!string.Equals(username, Username, StringComparison.Ordinal))
        {
            return; // Another profile was opened meanwhile; it starts over on its own.
        }

        _retrying = false;
        _focusProfileHeading = _profile is not null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusProblemHeading && _problemHeading.Id is not null)
        {
            _focusProblemHeading = false;
            await _problemHeading.FocusAsync();
        }

        if (_focusProfileHeading && _header is not null && _profile is not null)
        {
            _focusProfileHeading = false;
            await _header.FocusHeadingAsync();
        }

        await PreventTabKeyScrollingAsync();
    }

    // The tab keys select and focus a tab (MoveBetweenTabsAsync). Blazor cannot cancel the browser's own action for
    // some keys only, so a listener in PublicProfile.razor.js does it: otherwise Home and End also scroll the page.
    // Each new tab list (a new profile) gets it; the listener goes with the element.
    private async Task PreventTabKeyScrollingAsync()
    {
        if (_profile is null || _tablist.Id is not { } id || string.Equals(id, _guardedTablist, StringComparison.Ordinal))
        {
            return;
        }

        _guardedTablist = id;
        try
        {
            _tabKeys ??= JS.InvokeAsync<IJSObjectReference>("import", ScriptPath).AsTask();
            await (await _tabKeys).InvokeVoidAsync("preventTabKeyScrolling", _tablist);
        }
        catch (JSException)
        {
            // The script did not load: the keys still move between the tabs, only the page may scroll too.
        }
    }

    /// <summary>The signed-in user's username, or null for a visitor.</summary>
    private async Task<string?> ViewerAsync()
    {
        if (AuthState is null)
        {
            return null;
        }

        var user = (await AuthState).User;
        return user.Identity is { IsAuthenticated: true, Name: { } name } ? name : null;
    }

    private void ShowViewer(string? viewer)
    {
        _isSignedIn = viewer is not null;
        _isOwner = viewer is not null && string.Equals(viewer, _profile?.Username, StringComparison.OrdinalIgnoreCase);
    }

    private void Select(ProfileTab tab)
    {
        _tab = tab;
        _opened.Add(tab);
    }

    // Arrows wrap around; the newly selected tab takes the focus (selection follows focus). A key with a modifier is
    // the browser's (Alt+ArrowLeft goes back), here and in PublicProfile.razor.js.
    private async Task MoveBetweenTabsAsync(KeyboardEventArgs args)
    {
        if (args.AltKey || args.CtrlKey || args.MetaKey || args.ShiftKey)
        {
            return;
        }

        var current = Array.FindIndex(Tabs, t => t.Tab == _tab);
        var next = args.Key switch
        {
            "ArrowRight" => (current + 1) % Tabs.Length,
            "ArrowLeft" => (current + Tabs.Length - 1) % Tabs.Length,
            "Home" => 0,
            "End" => Tabs.Length - 1,
            _ => -1,
        };
        if (next < 0)
        {
            return;
        }

        Select(Tabs[next].Tab);
        await _tabButtons[next].FocusAsync();
    }

    private static string TabId(ProfileTab tab) => $"tab-{tab}";

    private static string PanelId(ProfileTab tab) => $"panel-{tab}";

    public async ValueTask DisposeAsync()
    {
        _cancel?.Cancel();
        _cancel?.Dispose();
        if (_tabKeys is not null)
        {
            try
            {
                await (await _tabKeys).DisposeAsync();
            }
            catch (JSException)
            {
                // It never loaded; nothing to release.
            }
        }
    }

    private enum ProfileTab
    {
        Shelf,
        Stats,
        Goals,
    }
}
