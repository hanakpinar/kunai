@page "/items/open"
@attribute [Authorize]
@inject KunaiApiClient Api
@inject AuthSession Session
@inject NavigationManager Navigation
@implements IDisposable

@* A search hit that is not in the catalog yet links here: import it, then show its page. *@

<PageTitle>İçerik açılıyor · Kunai</PageTitle>

@if (string.IsNullOrWhiteSpace(Ref))
{
    <EmptyState Message="Bu bağlantı eksik. Aramaya dönüp tekrar dene.">
        <a class="button" href="search">Aramaya dön</a>
    </EmptyState>
}
else if (_problem is null)
{
    <h1 class="visually-hidden">İçerik açılıyor</h1>
    <Spinner Label="İçerik kataloğa ekleniyor…" />
}
else
{
    <section class="open-item">
        <h1>İçerik açılamadı</h1>
        <ProblemAlert Problem="_problem" />
        <p class="open-item__actions">
            @if (_problem.IsRetryable)
            {
                <button type="button" class="button" disabled="@_busy" @onclick="OpenAsync">Tekrar dene</button>
            }
            <a class="button button--ghost" href="search">Aramaya dön</a>
        </p>
    </section>
}

@code {
    private CancellationTokenSource _cancel = new();
    private ApiProblem? _problem;
    private string? _openedRef;
    private bool _busy;

    [SupplyParameterFromQuery(Name = "ref")]
    public string? Ref { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(Ref, _openedRef, StringComparison.Ordinal))
        {
            return;
        }

        // Another ref replaced this one (or the link lost it): stop the old import, so its answer cannot
        // send the page to the wrong item or show a failure that belongs to it.
        _openedRef = Ref;
        _problem = null;
        await _cancel.CancelAsync();
        _cancel.Dispose();
        _cancel = new CancellationTokenSource();
        if (!string.IsNullOrWhiteSpace(Ref))
        {
            await OpenAsync();
        }
    }

    private async Task OpenAsync()
    {
        var token = _cancel.Token;
        _busy = true;
        _problem = null;
        try
        {
            // Safe to repeat: 201 for a new item, 200 when someone imported it already.
            var item = await Api.Api.V1.Items.Import.PostAsync(new ImportItemRequest { Ref = Ref }, cancellationToken: token);
            if (!token.IsCancellationRequested)
            {
                Navigation.NavigateTo($"items/{item?.Id}", replace: true);
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            // Another ref replaced this one, or the user left the page: its answer no longer matters.
        }
        catch (Exception exception) when (ApiProblem.IsApiFailure(exception))
        {
            if (!token.IsCancellationRequested)
            {
                _problem = ApiProblem.From(exception);
                await Session.RefreshIfExpiredAsync(_problem);
            }
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                _busy = false;
            }
        }
    }

    public void Dispose()
    {
        _cancel.Cancel();
        _cancel.Dispose();
    }
}
