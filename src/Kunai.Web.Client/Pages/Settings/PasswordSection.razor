@inherits SettingsSection

<section class="card settings-card" aria-labelledby="settings-password">
    <h2 id="settings-password">Şifre</h2>
    <p class="muted">Şifreni değiştirdiğinde diğer cihazlardaki oturumların kapanır; bu cihazda açık kalırsın.</p>

    <EditForm Model="_form" OnValidSubmit="SubmitAsync" class="form">
        <DataAnnotationsValidator />
        <label class="field">
            <span>Mevcut şifre</span>
            <InputText type="password" @bind-Value="_form.CurrentPassword" autocomplete="current-password" />
            <ValidationMessage For="() => _form.CurrentPassword" />
            <FieldError Problem="Problem" Field="currentPassword" />
        </label>
        <div class="field-row">
            @* An explicit label: the hint describes the input instead of becoming part of its name. *@
            <div class="field">
                <label for="settings-new-password" class="field-label">Yeni şifre</label>
                <InputText id="settings-new-password" type="password" @bind-Value="_form.NewPassword" autocomplete="new-password"
                           aria-describedby="settings-new-password-hint" />
                <small id="settings-new-password-hint" class="muted">En az 12 karakter. Uzun bir cümle iyi bir şifredir.</small>
                <ValidationMessage For="() => _form.NewPassword" />
                <FieldError Problem="Problem" Field="newPassword" />
            </div>
            <label class="field">
                <span>Yeni şifre (tekrar)</span>
                <InputText type="password" @bind-Value="_form.NewPasswordAgain" autocomplete="new-password" />
                <ValidationMessage For="() => _form.NewPasswordAgain" />
            </label>
        </div>

        <SectionFeedback Problem="AlertProblem(CurrentPasswordField, NewPasswordField)" Success="@Success" />

        <div class="settings-card__actions">
            <button type="submit" class="button" disabled="@Busy">Şifreyi değiştir</button>
        </div>
    </EditForm>
</section>

@code {
    private const string CurrentPasswordField = "currentPassword";
    private const string NewPasswordField = "newPassword";
    // Readonly on purpose: a new model would give EditForm a new EditContext, which rebuilds the whole form. The
    // success message would then arrive inside a brand-new live region, which screen readers often do not announce.
    private readonly ChangePasswordForm _form = new();

    private async Task SubmitAsync()
    {
        var saved = await SaveAsync(
            () => Api.Api.V1.Me.Password.PostAsync(new ChangePasswordRequest
            {
                CurrentPassword = _form.CurrentPassword,
                NewPassword = _form.NewPassword,
            }),
            "Şifren değişti. Diğer cihazlardaki oturumların kapatıldı.");

        if (saved)
        {
            _form.CurrentPassword = string.Empty;
            _form.NewPassword = string.Empty;
            _form.NewPasswordAgain = string.Empty;
        }
    }
}
