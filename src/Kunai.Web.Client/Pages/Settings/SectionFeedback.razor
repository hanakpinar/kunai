<ProblemAlert Problem="Problem" />
@* The status region is always on the page (hidden while empty, so it takes no room in the form), because screen
   readers announce a change inside a live region but often skip one that arrives together with its text. *@
<p role="status" class="@(string.IsNullOrEmpty(Success) ? "visually-hidden" : "alert alert--success")">@Success</p>

@code {
    [Parameter]
    public ApiProblem? Problem { get; set; }

    [Parameter]
    public string? Success { get; set; }
}
