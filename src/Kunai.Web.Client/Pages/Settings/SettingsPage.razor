@page "/settings"
@attribute [Authorize]
@using System.Net
@using Microsoft.Kiota.Abstractions
@inject KunaiApiClient Api
@inject AuthSession Session

<PageTitle>Ayarlar · Kunai</PageTitle>

<div class="settings">
    <header class="settings__header">
        <h1>Ayarlar</h1>
        <p class="muted">Profilini, tercihlerini ve hesabını buradan yönet.</p>
        @if (_me is not null)
        {
            <p class="muted small">Giriş e-postan: <strong>@_me.Email</strong></p>
        }
    </header>

    @if (_loading)
    {
        <Spinner Label="Ayarların yükleniyor…" />
    }
    else if (_problem is not null)
    {
        <ProblemAlert Problem="_problem" />
        @if (_problem.IsRetryable)
        {
            <div>
                <button type="button" class="button button--ghost" @onclick="LoadAsync">Tekrar dene</button>
            </div>
        }
    }
    else if (_me is null)
    {
        <EmptyState Message="Hesap bilgilerine şu an ulaşamadık." />
    }
    else
    {
        <ProfileSection @bind-Me="_me" />
        <PreferencesSection @bind-Me="_me" />
        <UsernameSection @bind-Me="_me" />
        <PasswordSection Me="_me" />
        <DeleteAccountSection Me="_me" />
    }
</div>

@code {
    private MeResponse? _me;
    private ApiProblem? _problem;
    private bool _loading;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _problem = null;
        try
        {
            _me = await Api.Api.V1.Me.GetAsync();
        }
        catch (Exception exception) when (exception is ApiException or HttpRequestException or TaskCanceledException)
        {
            _problem = ApiProblem.From(exception);
        }
        finally
        {
            _loading = false;
        }

        if (_problem?.Status == (int)HttpStatusCode.Unauthorized)
        {
            await RefreshSessionAsync();
        }
    }

    /// <summary>After a 401 (signed out in another tab, expired): once the session knows, the router asks for a sign-in.</summary>
    private async Task RefreshSessionAsync()
    {
        try
        {
            await Session.RefreshAsync();
        }
        catch (TaskCanceledException)
        {
            // GET /me timed out; the error above stays on the page.
        }
    }
}
